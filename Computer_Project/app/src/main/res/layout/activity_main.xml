<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp"
    android:fitsSystemWindows="true"
    tools:ignore="HardcodedText">

    <!-- 運算式顯示區：置頂，顯示目前輸入的算式，過長時從左側省略 -->
    <TextView
        android:id="@+id/tvExpression"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="end|top"
        android:textSize="36sp"
        android:textColor="#757575"
        android:maxLines="1"
        android:ellipsize="start"
        android:text=""
        tools:text="12 + 3 ×" />

    <!-- 輸出結果顯示區：緊接運算式下方，兩行文字之間不留空 -->
    <TextView
        android:id="@+id/tvResult"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="end|top"
        android:textSize="60sp"
        android:maxLines="1"
        android:ellipsize="start"
        android:text="0" />

    <!-- 彈性空白：吸收剩餘高度，把鍵盤推到畫面底部 -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 按鍵區：4 欄 5 列
         AC ⌫ ±  %
         7  8  9  ÷
         4  5  6  ×
         1  2  3  −
         0  .  =  + -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="5">

        <!-- row 0 -->
        <Button
            android:id="@+id/btnClear"
            android:contentDescription="清除全部"
            android:layout_row="0"
            android:layout_column="0"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_gravity="fill"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:background="@drawable/btn_calc"
            android:backgroundTint="@color/btn_function"
            android:textColor="@color/btn_function_text"
            android:textSize="32sp"
            android:text="AC" />

        <Button
            android:id="@+id/btnDiv"
            android:layout_row="1"
            android:layout_column="3"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_gravity="fill"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:background="@drawable/btn_calc"
            android:backgroundTint="@color/btn_operator"
            android:textColor="@color/btn_operator_text"
            android:textSize="32sp"
            android:text="÷" />

        <Button
            android:id="@+id/btnMul"
            android:layout_row="2"
            android:layout_column="3"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_gravity="fill"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:background="@drawable/btn_calc"
            android:backgroundTint="@color/btn_operator"
            android:textColor="@color/btn_operator_text"
            android:textSize="32sp"
            android:text="×" />

        <Button
            android:id="@+id/btnBackspace"
            android:contentDescription="退格，長按清除全部"
            android:layout_row="0"
            android:layout_column="1"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_gravity="fill"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:background="@drawable/btn_calc"
            android:backgroundTint="@color/btn_function"
            android:textColor="@color/btn_function_text"
            android:textSize="32sp"
            android:text="⌫" />

        <Button
            android:id="@+id/btnNegate"
            android:contentDescription="正負號切換"
            android:layout_row="0"
            android:layout_column="2"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_gravity="fill"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:background="@drawable/btn_calc"
            android:backgroundTint="@color/btn_function"
            android:textColor="@color/btn_function_text"
            android:textSize="32sp"
            android:text="±" />

        <Button
            android:id="@+id/btnPercent"
            android:contentDescription="百分比"
            android:layout_row="0"
            android:layout_column="3"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_gravity="fill"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:background="@drawable/btn_calc"
            android:backgroundTint="@color/btn_function"
            android:textColor="@color/btn_function_text"
            android:textSize="32sp"
            android:text="%" />

        <!-- row 1 -->
        <Button
            android:id="@+id/btn7"
            android:layout_row="1"
            android:layout_column="0"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_gravity="fill"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:background="@drawable/btn_calc"
            android:backgroundTint="@color/btn_number"
            android:textColor="@color/btn_number_text"
            android:textSize="32sp"
            android:text="7" />

        <Button
            android:id="@+id/btn8"
            android:layout_row="1"
            android:layout_column="1"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_gravity="fill"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:background="@drawable/btn_calc"
            android:backgroundTint="@color/btn_number"
            android:textColor="@color/btn_number_text"
            android:textSize="32sp"
            android:text="8" />

        <Button
            android:id="@+id/btn9"
            android:layout_row="1"
            android:layout_column="2"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_gravity="fill"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:background="@drawable/btn_calc"
            android:backgroundTint="@color/btn_number"
            android:textColor="@color/btn_number_text"
            android:textSize="32sp"
            android:text="9" />

        <Button
            android:id="@+id/btnSub"
            android:layout_row="3"
            android:layout_column="3"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_gravity="fill"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:background="@drawable/btn_calc"
            android:backgroundTint="@color/btn_operator"
            android:textColor="@color/btn_operator_text"
            android:textSize="32sp"
            android:text="−" />

        <!-- row 2 -->
        <Button
            android:id="@+id/btn4"
            android:layout_row="2"
            android:layout_column="0"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_gravity="fill"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:background="@drawable/btn_calc"
            android:backgroundTint="@color/btn_number"
            android:textColor="@color/btn_number_text"
            android:textSize="32sp"
            android:text="4" />

        <Button
            android:id="@+id/btn5"
            android:layout_row="2"
            android:layout_column="1"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_gravity="fill"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:background="@drawable/btn_calc"
            android:backgroundTint="@color/btn_number"
            android:textColor="@color/btn_number_text"
            android:textSize="32sp"
            android:text="5" />

        <Button
            android:id="@+id/btn6"
            android:layout_row="2"
            android:layout_column="2"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_gravity="fill"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:background="@drawable/btn_calc"
            android:backgroundTint="@color/btn_number"
            android:textColor="@color/btn_number_text"
            android:textSize="32sp"
            android:text="6" />

        <Button
            android:id="@+id/btnAdd"
            android:layout_row="4"
            android:layout_column="3"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_gravity="fill"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:background="@drawable/btn_calc"
            android:backgroundTint="@color/btn_operator"
            android:textColor="@color/btn_operator_text"
            android:textSize="32sp"
            android:text="+" />

        <!-- row 3 -->
        <Button
            android:id="@+id/btn1"
            android:layout_row="3"
            android:layout_column="0"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_gravity="fill"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:background="@drawable/btn_calc"
            android:backgroundTint="@color/btn_number"
            android:textColor="@color/btn_number_text"
            android:textSize="32sp"
            android:text="1" />

        <Button
            android:id="@+id/btn2"
            android:layout_row="3"
            android:layout_column="1"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_gravity="fill"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:background="@drawable/btn_calc"
            android:backgroundTint="@color/btn_number"
            android:textColor="@color/btn_number_text"
            android:textSize="32sp"
            android:text="2" />

        <Button
            android:id="@+id/btn3"
            android:layout_row="3"
            android:layout_column="2"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_gravity="fill"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:background="@drawable/btn_calc"
            android:backgroundTint="@color/btn_number"
            android:textColor="@color/btn_number_text"
            android:textSize="32sp"
            android:text="3" />

        <!-- row 4 -->
        <Button
            android:id="@+id/btnEquals"
            android:layout_row="4"
            android:layout_column="2"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_gravity="fill"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:background="@drawable/btn_calc"
            android:backgroundTint="@color/btn_equals"
            android:textColor="@color/btn_equals_text"
            android:textSize="32sp"
            android:text="=" />

        <Button
            android:id="@+id/btn0"
            android:layout_row="4"
            android:layout_column="0"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_gravity="fill"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:background="@drawable/btn_calc"
            android:backgroundTint="@color/btn_number"
            android:textColor="@color/btn_number_text"
            android:textSize="32sp"
            android:text="0" />

        <Button
            android:id="@+id/btnDot"
            android:layout_row="4"
            android:layout_column="1"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_gravity="fill"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:background="@drawable/btn_calc"
            android:backgroundTint="@color/btn_number"
            android:textColor="@color/btn_number_text"
            android:textSize="32sp"
            android:text="." />
    </GridLayout>
</LinearLayout>
