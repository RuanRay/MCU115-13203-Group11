<?xml version="1.0" encoding="utf-8"?>
<!-- 登入提示對話框 LoginPromptDialog（規格 4.1、FR-AUTH-06、guest_prompt.png） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_ticket"
    android:orientation="vertical">

    <com.group11.hometide.ui.widget.StampView
        android:id="@+id/stampMembersOnly"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/dialog_stamp_margin"
        app:stampColor="red"
        app:stampText="@string/stamp_members_only" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:paddingHorizontal="@dimen/page_horizontal_margin"
        android:text="@string/login_prompt_title"
        android:textAppearance="@style/TextAppearance.Hometide.Display"
        android:textColor="@color/color_on_background" />

    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3"
        android:paddingHorizontal="24dp"
        android:text="@string/login_prompt_body"
        android:textColor="@color/color_on_surface_muted" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/ticket_gap"
        android:layout_marginTop="16dp"
        android:background="@drawable/divider_tear_horizontal"
        android:layerType="software" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/page_horizontal_margin">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLater"
            style="@style/Widget.Hometide.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_later" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoLogin"
            style="@style/Widget.Hometide.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ticket_gap"
            android:layout_weight="1"
            android:text="@string/btn_go_login" />
    </LinearLayout>
</LinearLayout>
