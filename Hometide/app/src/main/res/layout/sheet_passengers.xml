<?xml version="1.0" encoding="utf-8"?>
<!-- 選擇乘客面板 sheetPassengers（4.1；passenger_sheet.png）。標題列右側說明依開啟位置切換 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPaxTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/pax_title"
                android:textAppearance="@style/TextAppearance.Hometide.Display"
                android:textColor="@color/color_on_background" />

            <TextView
                android:id="@+id/tvPaxHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Hometide.Body"
                android:textColor="@color/color_on_surface_muted" />
        </LinearLayout>

        <include
            android:id="@+id/rowPaxAdult"
            layout="@layout/item_pax_row" />

        <View
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="@drawable/divider_dashed_thin"
            android:layerType="software" />

        <include
            android:id="@+id/rowPaxStudent"
            layout="@layout/item_pax_row" />

        <View
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="@drawable/divider_dashed_thin"
            android:layerType="software" />

        <include
            android:id="@+id/rowPaxChild"
            layout="@layout/item_pax_row" />

        <View
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="@drawable/divider_dashed_thin"
            android:layerType="software" />

        <include
            android:id="@+id/rowPaxSenior"
            layout="@layout/item_pax_row" />

        <View
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="@drawable/divider_dashed_thin"
            android:layerType="software" />

        <include
            android:id="@+id/rowPaxDisabled"
            layout="@layout/item_pax_row" />

        <View
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="@drawable/divider_dashed_thin"
            android:layerType="software" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPaxTotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Hometide.Body"
                android:textColor="@color/color_on_background" />

            <TextView
                android:id="@+id/btnSetDefault"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:minHeight="@dimen/min_touch_target"
                android:paddingHorizontal="4dp"
                android:text="@string/btn_set_default"
                android:textAppearance="@style/TextAppearance.Hometide.Label"
                android:textColor="@color/color_primary" />
        </LinearLayout>

        <Button
            android:id="@+id/btnPaxConfirm"
            style="@style/Widget.Hometide.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/btn_pax_confirm" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
