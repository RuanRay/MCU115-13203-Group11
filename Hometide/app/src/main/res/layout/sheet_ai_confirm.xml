<?xml version="1.0" encoding="utf-8"?>
<!-- AI 確認卡 AiConfirmBottomSheet（4.4；ai_confirm.png）。AN-04 完整出票動畫於 7-3 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginVertical="12dp"
            android:background="@drawable/bg_sheet_handle"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_sparkle" />

            <TextView
                android:id="@+id/tvAiTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:accessibilityHeading="true"
                android:text="@string/ai_confirm_title"
                android:textAppearance="@style/TextAppearance.Hometide.Display"
                android:textColor="@color/color_primary" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvOriginal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/TextAppearance.Hometide.Body"
            android:textColor="@color/color_on_surface_muted" />

        <com.group11.hometide.ui.widget.TicketView
            android:id="@+id/tkAiPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:ticketStyle="main">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvAiMeta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:alpha="0.8"
                        android:letterSpacing="0.05"
                        android:textAppearance="@style/TextAppearance.Hometide.Body"
                        android:textColor="@color/color_on_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.8"
                        android:letterSpacing="0.05"
                        android:text="@string/ai_ticket_issuer"
                        android:textAppearance="@style/TextAppearance.Hometide.Body"
                        android:textColor="@color/color_on_primary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAiStations"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Hometide.Display"
                    android:textColor="@color/color_on_primary" />

                <TextView
                    android:id="@+id/tvAiDateTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.Hometide.Body"
                    android:textColor="@color/color_on_primary" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="@dimen/ticket_stub_max"
                android:layout_height="match_parent">

                <com.group11.hometide.ui.widget.StampView
                    android:id="@+id/vVerifyStamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    app:stampColor="mustard"
                    app:stampText="@string/ai_stamp_verified" />
            </FrameLayout>
        </com.group11.hometide.ui.widget.TicketView>

        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.Hometide.Body"
            android:textColor="@color/color_stamp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEdit"
                style="@style/Widget.Hometide.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_ai_edit" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirm"
                style="@style/Widget.Hometide.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1.2"
                android:text="@string/btn_ai_confirm" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
