<?xml version="1.0" encoding="utf-8"?>
<!-- P3 最近查詢一列（FR-SRCH-07、home.png）：時鐘＋起訖（非預設運具加括號）＋乘車日期 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/ticket_gap"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/color_surface"
    app:cardCornerRadius="@dimen/corner_ticket"
    app:cardElevation="0dp"
    app:strokeColor="@color/color_outline"
    app:strokeWidth="@dimen/button_stroke_width">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/min_touch_target"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_history" />

        <TextView
            android:id="@+id/tvRecentRoute"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Hometide.Body"
            android:textColor="@color/color_on_background" />

        <TextView
            android:id="@+id/tvRecentDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textAppearance="@style/TextAppearance.Hometide.Body"
            android:textColor="@color/color_on_surface_muted" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
