<?xml version="1.0" encoding="utf-8"?>
<!-- P4 查詢結果（規格 4.6、result.png、bus_result.png）。離線橫幅、下拉重新整理、空狀態於 4-4；排序選項於 4-3 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/page_horizontal_margin">

    <!-- 1–2. 返回＋運具＋路線標題、收藏 ♥ -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="0dp"
        app:contentInsetStart="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/min_touch_target"
                    android:textAppearance="@style/TextAppearance.Hometide.Body"
                    android:textColor="@color/color_on_surface_muted" />

                <TextView
                    android:id="@+id/tvRoute"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Hometide.Display"
                    android:textColor="@color/color_on_background" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnFavorite"
                android:layout_width="@dimen/min_touch_target"
                android:layout_height="@dimen/min_touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_favorite"
                android:src="@drawable/ic_heart" />
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- 3. 離線橫幅（FR-OFF-01）：芥末黃橫幅；滑下動畫 AN-16 於 7-3 -->
    <TextView
        android:id="@+id/tvOfflineBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_offline_banner"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:textAppearance="@style/TextAppearance.Hometide.Body"
        android:textColor="@color/offline_banner_text"
        android:visibility="gone" />

    <!-- 4–5. 日期章、班次數、時段晶片、排序 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.group11.hometide.ui.widget.DateStampView
            android:id="@+id/vDateStamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- CR-01 乘客（FR-RES-02；result_multi.png）：點擊開啟選擇乘客，只重算票價 -->
        <TextView
            android:id="@+id/chipPassengers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="@dimen/min_touch_target"
            android:paddingHorizontal="4dp"
            android:textAppearance="@style/TextAppearance.Hometide.Label"
            android:textColor="@color/color_primary" />

        <TextView
            android:id="@+id/tvCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textAppearance="@style/TextAppearance.Hometide.Body"
            android:textColor="@color/color_on_surface_muted" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Spinner
            android:id="@+id/spSort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_select"
            android:paddingHorizontal="8dp"
            android:minHeight="@dimen/min_touch_target"
            android:popupBackground="@color/color_surface" />
    </LinearLayout>

    <!-- AI 時段篩選（FR-AI-04）：有篩選時才出現，自成一列（上一列寬度不足，6-4b 實作者確認） -->
    <com.google.android.material.chip.Chip
        android:id="@+id/chipTimeRange"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <!-- 8. 下拉重新整理（小火車指示器 AN-12 於 7-3）；6–7. 時間軸列表、「現在」線（NowLineDecoration） -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTimeline"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="24dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- 載入中：3 張骨架車票（FR-RES-06） -->
        <LinearLayout
            android:id="@+id/layoutSkeleton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <include layout="@layout/item_ticket_skeleton" />

            <include layout="@layout/item_ticket_skeleton" />

            <include layout="@layout/item_ticket_skeleton" />
        </LinearLayout>

        <!-- 9. 空狀態／錯誤狀態 -->
        <include
            android:id="@+id/layoutEmpty"
            layout="@layout/layout_result_empty" />
    </FrameLayout>
</LinearLayout>
