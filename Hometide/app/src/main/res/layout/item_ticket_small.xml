<?xml version="1.0" encoding="utf-8"?>
<!-- 下一班「接下來的班次」小車票（規格 4.5 item_ticket_small、next.png）：出發 → 抵達、車種車次・狀態；存根票價 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="6dp">

    <com.group11.hometide.ui.widget.TicketView
        android:id="@+id/tkSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        app:ticketStyle="paper">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/tvSmallTimes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Hometide.TicketRoute.Large"
                android:textColor="@color/color_on_background" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSmallName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Hometide.Body"
                    android:textColor="@color/color_on_background" />

                <TextView
                    android:id="@+id/tvSmallStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Hometide.Label" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvSmallFare"
            android:layout_width="@dimen/ticket_stub_max"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Hometide.TicketTime.Large"
            android:textColor="@color/color_primary" />
    </com.group11.hometide.ui.widget.TicketView>
</FrameLayout>
