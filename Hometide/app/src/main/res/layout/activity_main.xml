<?xml version="1.0" encoding="utf-8"?>
<!-- 1-4 元件展示（暫時），1-5 改為正式頁面 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/page_horizontal_margin"
        android:paddingVertical="@dimen/page_horizontal_margin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.group11.hometide.ui.widget.DateStampView
                android:id="@+id/demoDateStamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ticket_gap" />

            <com.group11.hometide.ui.widget.DateStampView
                android:id="@+id/demoDateStampWeekday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 主票 -->
        <com.group11.hometide.ui.widget.TicketView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/page_horizontal_margin"
            app:ticketStyle="main">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="@dimen/ticket_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/demo_ticket_main_caption"
                    android:textAppearance="@style/TextAppearance.Hometide.Caption.Large"
                    android:textColor="?attr/colorOnPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/demo_ticket_route"
                    android:textAppearance="@style/TextAppearance.Hometide.TicketRoute.Large"
                    android:textColor="?attr/colorOnPrimary" />
            </LinearLayout>

            <TextView
                android:layout_width="80dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/demo_ticket_stub_main"
                android:textAppearance="@style/TextAppearance.Hometide.Button"
                android:textColor="?attr/colorOnPrimary" />
        </com.group11.hometide.ui.widget.TicketView>

        <!-- 紙票 -->
        <com.group11.hometide.ui.widget.TicketView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ticket_gap"
            app:ticketStyle="paper">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="@dimen/ticket_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/demo_ticket_paper_caption"
                    android:textAppearance="@style/TextAppearance.Hometide.Caption.Large"
                    android:textColor="?android:attr/textColorSecondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/demo_ticket_route"
                    android:textAppearance="@style/TextAppearance.Hometide.TicketRoute.Large"
                    android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>

            <TextView
                android:layout_width="80dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/demo_ticket_stub_paper"
                android:textAppearance="@style/TextAppearance.Hometide.TicketTime.Large"
                android:textColor="?attr/colorPrimary" />
        </com.group11.hometide.ui.widget.TicketView>

        <!-- 空白票 -->
        <com.group11.hometide.ui.widget.TicketView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ticket_gap"
            app:ticketStyle="blank">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="@dimen/ticket_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/demo_ticket_blank_caption"
                    android:textAppearance="@style/TextAppearance.Hometide.Caption.Large"
                    android:textColor="?android:attr/textColorSecondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/demo_ticket_route"
                    android:textAppearance="@style/TextAppearance.Hometide.TicketRoute.Large"
                    android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>

            <TextView
                android:layout_width="80dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/demo_ticket_stub_blank"
                android:textAppearance="@style/TextAppearance.Hometide.Button"
                android:textColor="?attr/colorOnPrimary" />
        </com.group11.hometide.ui.widget.TicketView>

        <!-- 印章：紅、灰、綠、芥末黃 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/page_horizontal_margin"
            android:orientation="horizontal">

            <com.group11.hometide.ui.widget.StampView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ticket_gap"
                app:stampColor="red"
                app:stampText="@string/demo_stamp_red" />

            <com.group11.hometide.ui.widget.StampView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ticket_gap"
                app:stampColor="gray"
                app:stampText="@string/demo_stamp_gray" />

            <com.group11.hometide.ui.widget.StampView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ticket_gap"
                app:stampColor="green"
                app:stampText="@string/demo_stamp_green" />

            <com.group11.hometide.ui.widget.StampView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:stampColor="mustard"
                app:stampText="@string/demo_stamp_mustard" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
