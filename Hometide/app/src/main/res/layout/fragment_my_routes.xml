<?xml version="1.0" encoding="utf-8"?>
<!-- P5 我的路線（規格 4.7、routes.png）：標題＋新增、車票夾／出發提醒分頁；訪客顯示問號車票＋登入 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/page_horizontal_margin">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/routes_title"
            android:textAppearance="@style/TextAppearance.Hometide.Display"
            android:textColor="@color/color_on_background" />

        <!-- 1. ＋ 新增 → P3 並聚焦手動查詢 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdd"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_add_route"
            android:textAppearance="@style/TextAppearance.Hometide.Label"
            android:textColor="@color/color_primary" />
    </LinearLayout>

    <!-- 2. 分頁：宋體、芥末黃底線 -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/page_horizontal_margin"
        android:layout_marginTop="8dp"
        android:background="@android:color/transparent"
        app:tabIndicatorColor="@color/color_accent"
        app:tabIndicatorFullWidth="true"
        app:tabIndicatorHeight="3dp"
        app:tabRippleColor="@null"
        app:tabSelectedTextColor="@color/color_primary"
        app:tabTextAppearance="@style/TextAppearance.Hometide.Label"
        app:tabTextColor="@color/color_on_surface_muted" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/ticket_outline_width"
        android:layout_marginHorizontal="@dimen/page_horizontal_margin"
        android:background="@color/color_outline" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 3. 內容 -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 訪客：問號車票＋「登入後即可使用我的路線」＋登入按鈕 -->
        <LinearLayout
            android:id="@+id/layoutRoutesGuest"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/color_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ill_ticket_question" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/routes_guest"
                android:textAppearance="@style/TextAppearance.Hometide.TicketRoute.Small"
                android:textColor="@color/color_on_background" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRoutesLogin"
                style="@style/Widget.Hometide.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minWidth="160dp"
                android:text="@string/btn_go_login" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
