<?xml version="1.0" encoding="utf-8"?>
<!-- 路線圖路段（規格 4.11 item_road_segment、FR-HWY-03）：色條依壅塞等級，右側時速；無資料灰色「—」、封閉「封閉」 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/road_segment_height"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="@dimen/road_rail_width"
        android:layout_height="match_parent">

        <View
            android:id="@+id/vRoadBar"
            android:layout_width="12dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_road_bar" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvRoadSpeed"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="end"
        android:textAppearance="@style/TextAppearance.Hometide.Label" />
</LinearLayout>
