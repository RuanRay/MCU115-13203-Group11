<?xml version="1.0" encoding="utf-8"?>
<!--
  車票夾項目（規格 4.7 item_ticket_route、4.4 rvFavorites；routes.png、home.png）。
  P5 為直式列表（可左滑刪除、長按 ≡ 拖曳）；P3 為橫向列表（固定寬度、不顯示 ≡）。
  vDeleteBg 只在左滑時顯示，避免從車票的半圓缺口透出紅色
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/ticket_gap">

    <FrameLayout
        android:id="@+id/vDeleteBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_swipe_delete"
        android:visibility="invisible">

        <TextView
            android:layout_width="@dimen/ticket_stub_max"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:gravity="center"
            android:text="@string/btn_delete"
            android:textAppearance="@style/TextAppearance.Hometide.Label"
            android:textColor="@color/color_on_primary" />
    </FrameLayout>

    <com.group11.hometide.ui.widget.TicketView
        android:id="@+id/tkRoute"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ticketStyle="paper">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:paddingVertical="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 運具・名稱；點擊改名（實作者確認 2026-11-18） -->
                <TextView
                    android:id="@+id/tvRouteMeta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:contentDescription="@string/cd_rename_route"
                    android:ellipsize="end"
                    android:letterSpacing="0.05"
                    android:maxLines="1"
                    android:minHeight="32dp"
                    android:gravity="center_vertical"
                    android:textAppearance="@style/TextAppearance.Hometide.Body" />

                <ImageView
                    android:id="@+id/ivDragHandle"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/cd_drag_handle"
                    android:scaleType="center"
                    android:src="@drawable/ic_drag_handle" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvRouteStations"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Hometide.TicketRoute.Large" />

            <TextView
                android:id="@+id/tvNextTrain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.Hometide.Body" />
        </LinearLayout>

        <!-- 存根：P5「查詢」、P3「一鍵查詢」 -->
        <TextView
            android:id="@+id/btnRouteQuery"
            android:layout_width="@dimen/ticket_stub_max"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:text="@string/btn_route_query"
            android:textAppearance="@style/TextAppearance.Hometide.Button" />
    </com.group11.hometide.ui.widget.TicketView>
</FrameLayout>
