<?xml version="1.0" encoding="utf-8"?>
<!-- 骨架車票（規格 4.1、FR-RES-06）：載入中顯示車票輪廓；閃光動畫 AN-11 於 7-3 -->
<com.group11.hometide.ui.widget.TicketView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="80dp"
    android:layout_marginBottom="16dp"
    android:importantForAccessibility="no"
    app:ticketStyle="paper">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="14dp">

        <View
            android:layout_width="140dp"
            android:layout_height="12dp"
            android:background="@drawable/bg_skeleton_bar" />

        <View
            android:layout_width="180dp"
            android:layout_height="24dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_skeleton_bar" />

        <View
            android:layout_width="96dp"
            android:layout_height="20dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_skeleton_bar" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="@dimen/ticket_stub_max"
        android:layout_height="match_parent"
        android:padding="14dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_skeleton_bar" />
    </FrameLayout>
</com.group11.hometide.ui.widget.TicketView>
