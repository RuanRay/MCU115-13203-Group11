<?xml version="1.0" encoding="utf-8"?>
<!-- P6 個人（規格 4.8、profile.png）。外觀（7-4）、意見回饋（7-2）尚未加入 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/page_horizontal_margin"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_profile"
            android:textAppearance="@style/TextAppearance.Hometide.Display"
            android:textColor="@color/color_on_background" />

        <!-- 1. 乘車會員證 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMember"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/color_primary"
            app:cardCornerRadius="@dimen/corner_ticket"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <View
                android:layout_width="@dimen/member_card_ring_size"
                android:layout_height="@dimen/member_card_ring_size"
                android:layout_gravity="end|top"
                android:layout_marginTop="-56dp"
                android:layout_marginEnd="-56dp"
                android:alpha="0.6"
                android:background="@drawable/bg_member_ring"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.8"
                    android:letterSpacing="0.2"
                    android:text="@string/member_card_title"
                    android:textAppearance="@style/TextAppearance.Hometide.Caption.Large"
                    android:textColor="@color/color_on_primary" />

                <!-- 會員 -->
                <LinearLayout
                    android:id="@+id/layoutMember"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNickname"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textAppearance="@style/TextAppearance.Hometide.Display"
                        android:textColor="@color/color_on_primary" />

                    <TextView
                        android:id="@+id/tvEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:alpha="0.8"
                        android:textColor="@color/color_on_primary" />

                    <!-- 預設運具、預設乘客（FR-SET-02；profile_passenger.png） -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvDefaultOperator"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:alpha="0.8"
                            android:textColor="@color/color_on_primary" />

                        <TextView
                            android:id="@+id/tvDefaultPassengers"
                            style="@style/Widget.Hometide.MemberPassengers"
                            android:layout_width="wrap_content" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 訪客：登入／註冊（FR-AUTH-04、06） -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMemberLogin"
                    style="@style/Widget.Hometide.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/btn_member_login"
                    android:textColor="@color/color_primary"
                    android:visibility="gone"
                    app:backgroundTint="@color/color_on_primary" />

                <!-- 訪客的預設乘客：登入按鈕下方（FR-SET-02，實作者確認 2026-11-18） -->
                <TextView
                    android:id="@+id/tvGuestPassengers"
                    style="@style/Widget.Hometide.MemberPassengers"
                    android:layout_width="match_parent"
                    android:gravity="end|center_vertical"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. 我的乘車紀錄＋統計區間（FR-USG-04） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="@string/stat_title"
                android:textAppearance="@style/TextAppearance.Hometide.TicketRoute.Small"
                android:textColor="@color/color_on_background" />

            <Spinner
                android:id="@+id/spRange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_select"
                android:contentDescription="@string/cd_stat_range"
                android:minHeight="@dimen/min_touch_target"
                android:minWidth="@dimen/stat_range_min_width"
                android:paddingHorizontal="8dp"
                android:popupBackground="@color/color_surface" />
        </LinearLayout>

        <!-- 3. 開啟次數、總使用時間 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_stat_ticket"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingVertical="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_open_count"
                    android:textAppearance="@style/TextAppearance.Hometide.Body"
                    android:textColor="@color/color_on_surface_muted" />

                <TextView
                    android:id="@+id/tvOpenCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.Hometide.Display"
                    android:includeFontPadding="false"
                    android:textSize="@dimen/stat_number_size"
                    android:textColor="@color/color_on_background" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_stat_ticket"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingVertical="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_total_time"
                    android:textAppearance="@style/TextAppearance.Hometide.Body"
                    android:textColor="@color/color_on_surface_muted" />

                <TextView
                    android:id="@+id/tvTotalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.Hometide.Display"
                    android:includeFontPadding="false"
                    android:textSize="@dimen/stat_number_size"
                    android:textColor="@color/color_on_background" />
            </LinearLayout>
        </LinearLayout>

        <!-- 4. 各頁停留時間（前 5 名） -->
        <LinearLayout
            android:id="@+id/layoutPageBars"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_stat_panel"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp" />

        <!-- 6. 意見回饋（外觀 spTheme 於 7-4 加在左側） -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFeedback"
            style="@style/Widget.Hometide.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/btn_feedback" />

        <!-- 7. 登出 -->
        <TextView
            android:id="@+id/btnLogout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:minHeight="@dimen/min_touch_target"
            android:paddingHorizontal="16dp"
            android:text="@string/btn_logout"
            android:textColor="@color/color_on_surface_muted"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
