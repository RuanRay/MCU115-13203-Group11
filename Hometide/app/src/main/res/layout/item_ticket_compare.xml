<?xml version="1.0" encoding="utf-8"?>
<!-- 回家方式比較車票（規格 4.11 item_ticket_compare、highway.png）：本體「運具・車次」「HH:mm 發車 → HH:mm」，存根總耗時與說明；
     最快者為主票樣式＋「最快」；沒有班次時淡化（實作者確認） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="6dp">

    <com.group11.hometide.ui.widget.TicketView
        android:id="@+id/tkCompare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ticketStyle="paper">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCompareLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:alpha="0.8"
                    android:ellipsize="end"
                    android:letterSpacing="0.05"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Hometide.Body" />

                <TextView
                    android:id="@+id/tvCompareFastest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:letterSpacing="0.1"
                    android:text="@string/hwy_fastest"
                    android:textAppearance="@style/TextAppearance.Hometide.Body"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCompareTimes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Hometide.TicketRoute.Small" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="@dimen/ticket_stub_max"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCompareTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Hometide.TicketTime.Large" />

            <TextView
                android:id="@+id/tvCompareNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Hometide.Caption.Large" />
        </LinearLayout>
    </com.group11.hometide.ui.widget.TicketView>
</FrameLayout>
