<?xml version="1.0" encoding="utf-8"?>
<!-- P5「出發提醒」分頁（FR-FAV-05、FR-RMD-05、reminders.png） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/page_horizontal_margin"
    android:paddingTop="8dp">

    <!-- 6. 通知權限提示列（FR-RMD-05）：通知未開啟就顯示，點擊開本 App 的通知設定 -->
    <TextView
        android:id="@+id/tvPermissionBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_permission_banner"
        android:minHeight="48dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:textAppearance="@style/TextAppearance.Hometide.Body"
        android:textColor="@color/color_on_background"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvReminders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    <com.group11.hometide.ui.widget.TicketView
        android:id="@+id/tkRemindersEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:ticketStyle="blank">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="20dp"
            android:text="@string/reminders_empty"
            android:textAppearance="@style/TextAppearance.Hometide.Body"
            android:textColor="@color/color_on_surface_muted" />
    </com.group11.hometide.ui.widget.TicketView>
</LinearLayout>
