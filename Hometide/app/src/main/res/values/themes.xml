<resources>
    <!-- 色票由 values／values-night 的 colors.xml 切換，兩種模式共用本主題 -->
    <style name="Base.Theme.Hometide" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:colorBackground">@color/color_background</item>
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorOnPrimary">@color/color_on_primary</item>
        <item name="colorSecondary">@color/color_accent</item>
        <item name="colorError">@color/color_stamp</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorOnSurface">@color/color_on_background</item>
        <item name="colorOnBackground">@color/color_on_background</item>
        <item name="colorSurfaceVariant">@color/color_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/color_on_surface_muted</item>
        <item name="colorOutline">@color/color_outline</item>
        <!-- M3 底部導覽選中底塊取 secondaryContainer（5.1：選中的導覽項目用 surface_variant；圖示色照 home.png 用主色） -->
        <item name="colorSecondaryContainer">@color/color_surface_variant</item>
        <item name="colorOnSecondaryContainer">@color/color_primary</item>
        <!-- M3 元件（底部導覽、卡片、Bottom Sheet）預設取 surfaceContainer*，統一成 color_surface -->
        <item name="colorSurfaceContainerLowest">@color/color_surface</item>
        <item name="colorSurfaceContainerLow">@color/color_surface</item>
        <item name="colorSurfaceContainer">@color/color_surface</item>
        <item name="colorSurfaceContainerHigh">@color/color_surface</item>
        <item name="colorSurfaceContainerHighest">@color/color_surface</item>
        <item name="android:textColorPrimary">@color/color_on_background</item>
        <item name="android:textColorSecondary">@color/color_on_surface_muted</item>
        <item name="android:textColorTertiary">@color/color_on_surface_muted</item>
        <!-- 預設字體走 textViewStyle：主題層 fontFamily 會蓋過各元件的 textAppearance -->
        <item name="android:textViewStyle">@style/Widget.Hometide.TextView</item>
        <item name="bottomNavigationStyle">@style/Widget.Hometide.BottomNav</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Hometide" parent="Base.Theme.Hometide" />

    <style name="Widget.Hometide.TextView" parent="Widget.MaterialComponents.TextView">
        <item name="android:textAppearance">@style/TextAppearance.Hometide.Body</item>
    </style>

    <!-- 底部導覽列（規格 4.1）：選中藏青粗體、未選中次要文字色，上緣分隔線 -->
    <style name="Widget.Hometide.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@drawable/bg_bottom_nav</item>
        <item name="itemIconTint">@color/nav_item</item>
        <item name="itemTextColor">@color/nav_item</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.Hometide.Caption.Large</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Hometide.NavLabel.Active</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="TextAppearance.Hometide.NavLabel.Active" parent="TextAppearance.Hometide.Caption.Large">
        <item name="fontFamily">@font/noto_sans_tc_bold</item>
        <item name="android:fontFamily">@font/noto_sans_tc_bold</item>
    </style>

    <!-- 輸入框（P1、P2；畫面圖：紙色底、框線、6dp 圓角） -->
    <style name="Widget.Hometide.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/color_surface</item>
        <item name="boxStrokeColor">@color/text_input_stroke</item>
        <item name="boxStrokeErrorColor">@color/color_stamp</item>
        <item name="errorTextColor">@color/color_stamp</item>
        <item name="errorIconDrawable">@null</item>
        <item name="hintTextColor">@color/color_on_surface_muted</item>
        <item name="android:textColorHint">@color/color_on_surface_muted</item>
        <item name="boxCornerRadiusTopStart">@dimen/corner_control_large</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_control_large</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_control_large</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_control_large</item>
    </style>

    <style name="Widget.Hometide.TextInputLayout.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxBackgroundColor">@color/color_surface</item>
        <item name="boxStrokeColor">@color/text_input_stroke</item>
        <item name="hintTextColor">@color/color_on_surface_muted</item>
        <item name="android:textColorHint">@color/color_on_surface_muted</item>
        <item name="boxCornerRadiusTopStart">@dimen/corner_control_large</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_control_large</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_control_large</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_control_large</item>
    </style>

    <!-- 按鈕：主色實心、藏青外框（P1、P2、對話框） -->
    <style name="Widget.Hometide.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAppearance">@style/TextAppearance.Hometide.Button</item>
        <item name="cornerRadius">@dimen/corner_control_large</item>
    </style>

    <style name="Widget.Hometide.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAppearance">@style/TextAppearance.Hometide.Button</item>
        <item name="android:textColor">@color/color_primary</item>
        <item name="cornerRadius">@dimen/corner_control_large</item>
        <item name="strokeColor">@color/color_primary</item>
        <item name="strokeWidth">@dimen/button_stroke_width</item>
    </style>

    <!-- P3 範例句晶片（home.png）：紙色底、藏青框與字 -->
    <style name="Widget.Hometide.Chip.Example" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/color_surface</item>
        <item name="chipStrokeColor">@color/color_primary</item>
        <item name="chipStrokeWidth">@dimen/button_stroke_width</item>
        <item name="chipCornerRadius">@dimen/corner_floating_input</item>
        <item name="android:textColor">@color/color_primary</item>
        <item name="android:textAppearance">@style/TextAppearance.Hometide.Label</item>
    </style>

    <!-- P6 會員證「預設乘客：全票 1 ›」（profile_passenger.png）：可點，會員與訪客共用 -->
    <style name="Widget.Hometide.MemberPassengers" parent="">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:alpha">0.8</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="android:textColor">@color/color_on_primary</item>
    </style>

    <!-- 下一班路線晶片（next.png）：單選，選中藏青底 -->
    <style name="Widget.Hometide.Chip.Route" parent="Widget.Hometide.Chip.Example">
        <item name="android:checkable">true</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipBackgroundColor">@color/chip_route_bg</item>
        <item name="android:textColor">@color/chip_route_text</item>
    </style>

    <!-- P4 狀態／設施標籤（result.png）：外框與字同色，顏色由程式依狀態設定 -->
    <style name="Widget.Hometide.Tag" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:background">@drawable/bg_tag</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:paddingVertical">2dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Hometide.Label</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- P3 起站／迄站：宋體大字、無底線（home.png） -->
    <style name="Widget.Hometide.StationInput" parent="Widget.AppCompat.AutoCompleteTextView">
        <item name="android:background">@null</item>
        <item name="android:completionThreshold">1</item>
        <item name="android:dropDownWidth">200dp</item>
        <item name="android:imeOptions">actionNext</item>
        <item name="android:inputType">text</item>
        <item name="android:maxLines">1</item>
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="android:popupBackground">@color/color_surface</item>
        <item name="android:textAppearance">@style/TextAppearance.Hometide.TicketRoute.Large</item>
        <item name="android:textColor">@color/color_on_background</item>
        <item name="android:textColorHint">@color/color_outline</item>
    </style>

    <!-- 文字樣式（規格 5.2）。parent 用 AppCompat，不繼承 M3 的固定 lineHeight（避免 40sp 倒數被裁切） -->
    <style name="TextAppearance.Hometide.Display" parent="TextAppearance.AppCompat">
        <item name="fontFamily">@font/noto_serif_tc_black</item>
        <item name="android:fontFamily">@font/noto_serif_tc_black</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="TextAppearance.Hometide.TicketRoute.Large" parent="TextAppearance.Hometide.Display">
        <item name="android:textSize">22sp</item>
    </style>

    <style name="TextAppearance.Hometide.TicketRoute.Small" parent="TextAppearance.Hometide.Display">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="TextAppearance.Hometide.TicketTime.Large" parent="TextAppearance.Hometide.Display">
        <item name="android:textSize">17sp</item>
    </style>

    <style name="TextAppearance.Hometide.TicketTime.Small" parent="TextAppearance.Hometide.Display">
        <item name="android:textSize">15sp</item>
    </style>

    <style name="TextAppearance.Hometide.Countdown" parent="TextAppearance.Hometide.Display">
        <item name="android:textSize">40sp</item>
    </style>

    <style name="TextAppearance.Hometide.Body" parent="TextAppearance.AppCompat">
        <item name="fontFamily">@font/noto_sans_tc_regular</item>
        <item name="android:fontFamily">@font/noto_sans_tc_regular</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.Hometide.Caption.Large" parent="TextAppearance.AppCompat">
        <item name="fontFamily">@font/noto_sans_tc_medium</item>
        <item name="android:fontFamily">@font/noto_sans_tc_medium</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.Hometide.Caption.Small" parent="TextAppearance.Hometide.Caption.Large">
        <item name="android:textSize">10sp</item>
    </style>

    <style name="TextAppearance.Hometide.Button" parent="TextAppearance.AppCompat">
        <item name="fontFamily">@font/noto_serif_tc_bold</item>
        <item name="android:fontFamily">@font/noto_serif_tc_bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.2</item>
    </style>

    <!-- 宋體粗體標籤、不加字距：範例句晶片、區段標題（home.png） -->
    <style name="TextAppearance.Hometide.Label" parent="TextAppearance.Hometide.Button">
        <item name="android:letterSpacing">0</item>
    </style>
    <!-- 國道表單欄位（highway_guest.png）：框線方塊內「小標籤＋下拉」 -->
    <style name="Widget.Hometide.HwyField" parent="">
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_hwy_field</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">2dp</item>
    </style>

    <style name="Widget.Hometide.HwyFieldLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.Hometide.Caption.Large</item>
        <item name="android:textColor">@color/color_on_surface_muted</item>
    </style>

    <style name="Widget.Hometide.HwySpinner" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="android:background">@null</item>
        <item name="android:popupBackground">@color/color_surface</item>
    </style>

    <!-- 路況圖例：色塊＋同色文字 -->
    <style name="Widget.Hometide.HwyLegend" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textAppearance">@style/TextAppearance.Hometide.Body</item>
    </style>

    <!-- 國道訪客提示卡（highway_guest.png）：紙色底、主色框線 -->
    <style name="Widget.Hometide.HintCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/color_surface</item>
        <item name="strokeColor">@color/color_primary</item>
        <item name="strokeWidth">@dimen/button_stroke_width</item>
        <item name="cardCornerRadius">@dimen/corner_control_small</item>
        <item name="cardElevation">0dp</item>
    </style>
</resources>
