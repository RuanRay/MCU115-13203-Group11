<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 車票元件（規格 4.1）：第一個子 View 為本體、第二個為存根 -->
    <declare-styleable name="TicketView">
        <attr name="ticketStyle" format="enum">
            <enum name="main" value="0" />
            <enum name="paper" value="1" />
            <enum name="blank" value="2" />
        </attr>
    </declare-styleable>

    <!-- 印章元件（規格 4.1） -->
    <declare-styleable name="StampView">
        <attr name="stampText" format="string" />
        <attr name="stampColor" format="enum">
            <enum name="red" value="0" />
            <enum name="gray" value="1" />
            <enum name="green" value="2" />
            <enum name="mustard" value="3" />
        </attr>
    </declare-styleable>
</resources>
