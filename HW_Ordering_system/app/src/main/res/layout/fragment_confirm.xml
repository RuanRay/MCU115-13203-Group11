<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Screen"
    tools:context=".ConfirmFragment">

    <LinearLayout style="@style/ScreenContent">

        <TextView
            style="@style/Title"
            android:text="@string/confirm_title" />

        <TextView
            style="@style/Subtitle"
            android:text="@string/confirm_subtitle" />

        <LinearLayout
            style="@style/Card"
            android:layout_marginBottom="16dp">

            <TextView
                style="@style/CardTitle"
                android:text="@string/order_summary_title" />

            <TextView
                android:id="@+id/tvSummary"
                style="@style/CardBody"
                tools:text="@string/order_summary" />
        </LinearLayout>

        <Button
            android:id="@+id/btnConfirm"
            style="@style/PrimaryButton"
            android:text="@string/confirm" />

        <!-- 不提交、直接回主畫面 -->
        <Button
            android:id="@+id/btnBack"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="@string/back"
            android:textAllCaps="false"
            android:textColor="@color/green_dark"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
