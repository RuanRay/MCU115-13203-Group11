<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <!-- 四個副畫面（Fragment）；開啟時蓋掉主畫面 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/mainScreen"
        style="@style/Screen">

    <LinearLayout style="@style/ScreenContent">

        <TextView
            style="@style/Title"
            android:text="@string/main_title" />

        <TextView
            style="@style/Subtitle"
            android:text="@string/main_subtitle" />

        <Button
            android:id="@+id/btnMainMeal"
            style="@style/Row.Entry"
            android:text="@string/choose_main_meal" />

        <Button
            android:id="@+id/btnSideDishes"
            style="@style/Row.Entry"
            android:text="@string/choose_side_dishes" />

        <Button
            android:id="@+id/btnDrink"
            style="@style/Row.Entry"
            android:text="@string/choose_drink" />

        <!-- 目前選擇；提交後標題改為「已送出的訂單」 -->
        <LinearLayout
            style="@style/Card"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/tvSummaryTitle"
                style="@style/CardTitle"
                android:text="@string/current_selection" />

            <TextView
                android:id="@+id/tvSummary"
                style="@style/CardBody"
                tools:text="@string/order_summary" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnOrder"
            style="@style/PrimaryButton"
            android:text="@string/order" />
    </LinearLayout>
    </ScrollView>
</FrameLayout>
